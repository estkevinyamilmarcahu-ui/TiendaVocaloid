<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Tienda Vocaloid</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        :root {
            --miku: #39c5bb;
            --miku-dark: #2a9d8f;
        }
        body {
            background: linear-gradient(135deg, #f0f9ff 0%, #e0f7fa 100%);
            min-height: 100vh;
        }
        .navbar {
            background: linear-gradient(90deg, #39c5bb, #00bcd4) !important;
        }
        .navbar-brand, .nav-link {
            color: white !important;
            font-weight: 600;
        }
        .btn-miku {
            background-color: var(--miku);
            border-color: var(--miku);
            color: white;
        }
        .btn-miku:hover {
            background-color: var(--miku-dark);
            border-color: var(--miku-dark);
            color: white;
        }
        .card {
            border: none;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(57, 197, 187, 0.15);
            transition: transform 0.2s;
        }
        .card:hover {
            transform: translateY(-4px);
        }
        .badge-voicebank { background-color: #39c5bb; }
        .badge-figura { background-color: #e91e63; }
        .badge-merch { background-color: #ff9800; }
        .badge-software { background-color: #3f51b5; }
        footer {
            background: #263238;
            color: #90a4ae;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark shadow-sm">
            <div class="container">
                <a class="navbar-brand" href="/Producto">
                    <i class="bi bi-music-note-beamed"></i> Tienda Vocaloid
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link" href="/Producto"><i class="bi bi-grid"></i> Catálogo</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Producto/Create"><i class="bi bi-plus-circle"></i> Nuevo Producto</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container py-4">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="py-3 mt-auto">
        <div class="container text-center">
            <span>&copy; 2026 - Tienda Vocaloid | Hecho con 💙 y ミク</span>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
