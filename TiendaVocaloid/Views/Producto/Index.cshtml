@model IEnumerable<TiendaVocaloid.Models.Producto>

@{
    ViewData["Title"] = "Catálogo Vocaloid";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">
        <i class="bi bi-music-note-list"></i> Catálogo de Productos
    </h2>
    <a href="/Producto/Create" class="btn btn-miku">
        <i class="bi bi-plus-lg"></i> Nuevo Producto
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info text-center py-5">
        <i class="bi bi-inbox" style="font-size: 3rem;"></i>
        <h4 class="mt-3">No hay productos todavía</h4>
        <p>¡Agregá el primer producto de la tienda Vocaloid!</p>
        <a href="/Producto/Create" class="btn btn-miku">Crear Producto</a>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title mb-0">@item.Nombre</h5>
                            @{
                                var badgeClass = item.Categoria?.ToLower() switch
                                {
                                    "voicebank" => "badge-voicebank",
                                    "figura" => "badge-figura",
                                    "merch" => "badge-merch",
                                    "software" => "badge-software",
                                    _ => "bg-secondary"
                                };
                            }
                            <span class="badge @badgeClass">@item.Categoria</span>
                        </div>
                        
                        <p class="card-text text-muted small">
                            @(item.Descripcion ?? "Sin descripción")
                        </p>
                        
                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <span class="fs-4 fw-bold text-success">$@item.Precio.ToString("N0")</span>
                            <span class="text-muted">
                                <i class="bi bi-box-seam"></i> Stock: @item.Stock
                            </span>
                        </div>
                    </div>
                    <div class="card-footer bg-transparent border-0 pt-0">
                        <div class="d-flex gap-2">
                            <a href="/Producto/Details/@item.Id" class="btn btn-outline-primary btn-sm flex-fill">
                                <i class="bi bi-eye"></i> Ver
                            </a>
                            <a href="/Producto/Edit/@item.Id" class="btn btn-outline-warning btn-sm flex-fill">
                                <i class="bi bi-pencil"></i> Editar
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
