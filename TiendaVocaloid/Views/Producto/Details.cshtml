@model TiendaVocaloid.Models.Producto

@{
    ViewData["Title"] = "Detalles del Producto";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card">
            <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
                <h4 class="mb-0"><i class="bi bi-info-circle"></i> Detalles del Producto</h4>
                @{
                    var badgeClass = Model.Categoria?.ToLower() switch
                    {
                        "voicebank" => "badge-voicebank",
                        "figura" => "badge-figura",
                        "merch" => "badge-merch",
                        "software" => "badge-software",
                        _ => "bg-secondary"
                    };
                }
                <span class="badge @badgeClass fs-6">@Model.Categoria</span>
            </div>
            <div class="card-body">
                <h3 class="mb-3">@Model.Nombre</h3>
                
                <dl class="row">
                    <dt class="col-sm-4">Precio</dt>
                    <dd class="col-sm-8 fs-4 text-success fw-bold">$@Model.Precio.ToString("N0")</dd>

                    <dt class="col-sm-4">Stock disponible</dt>
                    <dd class="col-sm-8">
                        <span class="badge @(Model.Stock > 0 ? "bg-success" : "bg-danger")">
                            @Model.Stock unidades
                        </span>
                    </dd>

                    <dt class="col-sm-4">Descripción</dt>
                    <dd class="col-sm-8">@(Model.Descripcion ?? "Sin descripción")</dd>
                </dl>

                <hr />

                <div class="d-flex gap-2 flex-wrap">
                    <a href="/Producto/Edit/@Model.Id" class="btn btn-warning">
                        <i class="bi bi-pencil"></i> Editar
                    </a>
                    
                    <form asp-action="Delete" method="post" class="d-inline" 
                          onsubmit="return confirm('¿Estás seguro de eliminar este producto?');">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash"></i> Eliminar
                        </button>
                    </form>

                    <a href="/Producto" class="btn btn-outline-secondary ms-auto">
                        <i class="bi bi-arrow-left"></i> Volver al Catálogo
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
